# Settings for the local monitoring example. Every value here is a local test
# value: change them all before running this anywhere but your own machine.

BUCKETS_IMAGE=ghcr.io/storscale/bucketsd:1.17.1
BUCKETS_ROOT_USER=admin
BUCKETS_ROOT_PASSWORD=monitoring-admin-1

# The metrics-only user Prometheus scrapes as (policy buckets-prometheus).
PROMETHEUS_USER=prometheus
PROMETHEUS_SECRET=prometheus-secret-1

GRAFANA_ADMIN_PASSWORD=grafana-admin-1
