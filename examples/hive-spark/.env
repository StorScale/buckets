# Settings for the local Hive Metastore and Spark example. Every value here is
# a local test value: change them all before running this anywhere but your
# own machine.

# The Buckets server image. Releases are on ghcr.io/storscale.
BUCKETS_IMAGE=ghcr.io/storscale/bucketsd:1.15.1

BUCKETS_ROOT_USER=admin
BUCKETS_ROOT_PASSWORD=lakehouse-admin-1

# Buckets service accounts for the engines and the metastore. Only these can
# read the warehouse.
TRINO_S3_ACCESS_KEY=trino-svc
TRINO_S3_SECRET_KEY=trino-svc-secret-1
SPARK_S3_ACCESS_KEY=spark-svc
SPARK_S3_SECRET_KEY=spark-svc-secret-1
HMS_S3_ACCESS_KEY=hms-svc
HMS_S3_SECRET_KEY=hms-svc-secret-1

# The metastore's Postgres database.
HMS_DB_PASSWORD=metastore-db-1

# Ranger: the admin UI password (user "admin") and its database's passwords.
# Ranger wants 8+ characters with letters and digits.
RANGER_PASSWORD=rangerR0cks1
# Trino's Ranger plugin signs in to Ranger as "trino-plugin" to fetch policies.
RANGER_PLUGIN_PASSWORD=trinoPlugin1

KEYCLOAK_ADMIN_PASSWORD=keycloak-admin-1
# The password of the example users alice, bob and carol.
LAKEHOUSE_USER_PASSWORD=lakehouse-user-1

TRINO_SHARED_SECRET=lakehouse-trino-internal-secret-change-me
