<?xml version="1.0" encoding="UTF-8"?>
<!-- The metastore reaches Buckets with S3A: it creates and removes the
     directories of databases and managed tables. Its credentials are the
     AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY environment variables. -->
<configuration>
  <property>
    <name>fs.s3a.endpoint</name>
    <value>http://buckets:9000</value>
  </property>
  <property>
    <name>fs.s3a.endpoint.region</name>
    <value>us-east-1</value>
  </property>
  <property>
    <name>fs.s3a.path.style.access</name>
    <value>true</value>
  </property>
  <property>
    <name>fs.s3a.connection.ssl.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>fs.s3a.aws.credentials.provider</name>
    <value>software.amazon.awssdk.auth.credentials.EnvironmentVariableCredentialsProvider</value>
  </property>
</configuration>
