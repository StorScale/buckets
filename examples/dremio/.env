# Settings for the local Dremio example, beside ../lakehouse/.env (which this
# example includes). Every value here is a local test value: change them all
# before running this anywhere but your own machine.

# Dremio's first administrator (user "admin"). Dremio wants 8+ characters,
# with letters and digits.
DREMIO_ADMIN_PASSWORD=dremioAdmin1

# Dremio's Buckets service account: it may read the warehouse and the
# datasets bucket, and write nothing.
DREMIO_S3_ACCESS_KEY=dremio-svc
DREMIO_S3_SECRET_KEY=dremio-svc-secret-1
