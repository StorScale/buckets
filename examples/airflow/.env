# Settings for the local Airflow example, beside ../lakehouse/.env (which this
# example includes). Every value here is a local test value: change them all
# before running this anywhere but your own machine.

# Airflow's Keycloak clients: "airflow" for people's sign-in, and
# "airflow-pipelines", the service account the pipelines run as.
AIRFLOW_OAUTH_SECRET=airflow-oauth-secret-change-me
AIRFLOW_PIPELINES_SECRET=airflow-pipelines-secret-change-me

# Airflow's database, the key it encrypts connections with (Fernet), and the
# keys it signs sessions and API tokens with.
AIRFLOW_DB_PASSWORD=airflow-db-1
AIRFLOW_FERNET_KEY=CSBZLmAwTIsrdgMBhMFFF2fNOAUM-qrBrbPwm5i5BY8=
AIRFLOW_SECRET_KEY=airflow-session-key-change-me-0123456789
AIRFLOW_JWT_SECRET=airflow-jwt-secret-change-me-0123456789
