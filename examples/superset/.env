# Settings for the local Superset example, beside ../lakehouse/.env (which
# this example includes). Every value here is a local test value: change them
# all before running this anywhere but your own machine.

# Superset's Keycloak client secret, its session key, and its database.
SUPERSET_OAUTH_SECRET=superset-oauth-secret-change-me
SUPERSET_SECRET_KEY=superset-session-key-change-me-0123456789abcdef
SUPERSET_DB_PASSWORD=superset-db-1

# The password Superset signs in to Trino with, as the service user "superset".
SUPERSET_TRINO_PASSWORD=superset-trino-1
