{
  "realm": "lakehouse",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "groups": [
    { "name": "analysts" },
    { "name": "engineers" }
  ],
  "users": [
    {
      "username": "alice", "enabled": true, "emailVerified": true,
      "email": "alice@example.com", "firstName": "Alice", "lastName": "Analyst",
      "credentials": [{ "type": "password", "value": "${LAKEHOUSE_USER_PASSWORD}", "temporary": false }],
      "groups": ["/analysts"]
    },
    {
      "username": "bob", "enabled": true, "emailVerified": true,
      "email": "bob@example.com", "firstName": "Bob", "lastName": "Engineer",
      "credentials": [{ "type": "password", "value": "${LAKEHOUSE_USER_PASSWORD}", "temporary": false }],
      "groups": ["/engineers"]
    },
    {
      "username": "carol", "enabled": true, "emailVerified": true,
      "email": "carol@example.com", "firstName": "Carol", "lastName": "Contractor",
      "credentials": [{ "type": "password", "value": "${LAKEHOUSE_USER_PASSWORD}", "temporary": false }],
      "groups": []
    }
  ],
  "clients": [
    {
      "clientId": "lakehouse",
      "name": "Lakehouse (Trino and Buckets)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*", "https://localhost:*"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lakehouse",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
