# buckets_download(<file> URLS <url>... [SHA256 <hash>] [TIMEOUT <s>]): downloads
# file from the first url that serves it (mirrors in order), retrying the lot
# with backoff. CMake's own downloads (file(DOWNLOAD), FetchContent's URL) retry
# only on network errors, so a 502/503/504 from GitHub's archive servers failed
# the whole build at once. A file already there (with the right hash, when one
# is given) is kept, and a failed attempt leaves nothing behind: on failure the
# file is missing and BUCKETS_DOWNLOAD_ERROR says why.
set(BUCKETS_DOWNLOAD_ATTEMPTS 6 CACHE STRING "Attempts per dependency download")
set(BUCKETS_DEPS_PREFIX "${CMAKE_SOURCE_DIR}/.deps" CACHE PATH "Where source-built dependencies are installed")

function(buckets_download file)
  cmake_parse_arguments(PARSE_ARGV 1 _d "" "SHA256;TIMEOUT" "URLS")
  if(EXISTS "${file}")
    if(NOT _d_SHA256)
      return()
    endif()
    file(SHA256 "${file}" _sum)
    if(_sum STREQUAL _d_SHA256)
      return()
    endif()
    file(REMOVE "${file}")
  endif()
  set(_timeout)
  if(_d_TIMEOUT)
    set(_timeout TIMEOUT ${_d_TIMEOUT})
  endif()
  # a name of its own, so builds sharing BUCKETS_DEPS_PREFIX can download at once
  string(RANDOM LENGTH 8 _tag)
  set(_part "${file}.${_tag}.part")
  set(_wait 2)
  foreach(_attempt RANGE 1 ${BUCKETS_DOWNLOAD_ATTEMPTS})
    foreach(_url IN LISTS _d_URLS)
      file(DOWNLOAD "${_url}" "${_part}" ${_timeout} INACTIVITY_TIMEOUT 60 TLS_VERIFY ON STATUS _st)
      list(GET _st 0 _rc)
      list(GET _st 1 _msg)
      if(_rc EQUAL 0 AND _d_SHA256)
        file(SHA256 "${_part}" _sum)
        if(NOT _sum STREQUAL _d_SHA256)
          set(_rc 1)
          set(_msg "SHA256 mismatch (${_sum})")
        endif()
      endif()
      if(_rc EQUAL 0)
        file(RENAME "${_part}" "${file}")
        return()
      endif()
      file(REMOVE "${_part}")
      message(STATUS "buckets: ${_url}: ${_msg}")
    endforeach()
    if(_attempt LESS BUCKETS_DOWNLOAD_ATTEMPTS)
      message(STATUS "buckets: retrying in ${_wait} s")
      execute_process(COMMAND ${CMAKE_COMMAND} -E sleep ${_wait})
      math(EXPR _wait "${_wait} * 2")
    endif()
  endforeach()
  set(BUCKETS_DOWNLOAD_ERROR "${_msg}" PARENT_SCOPE)
endfunction()
