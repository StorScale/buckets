   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(minio_s3_requests_ttfb_seconds_distribution{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"node\"}[5m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
