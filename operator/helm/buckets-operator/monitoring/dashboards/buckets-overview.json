  {
   "type": "stat",
   "title": "Usable capacity used",
   "description": "",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - min(minio_cluster_capacity_usable_free_bytes{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"cluster\"}) / max(minio_cluster_capacity_usable_total_bytes{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"cluster\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.85
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
