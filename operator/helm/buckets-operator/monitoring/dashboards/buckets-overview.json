   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(minio_s3_requests_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"node\"}[5m]))",
     "legendFormat": "requests",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(minio_s3_requests_4xx_errors_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"node\"}[5m]))",
     "legendFormat": "4xx",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "sum(rate(minio_s3_requests_5xx_errors_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"node\"}[5m]))",
     "legendFormat": "5xx",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
