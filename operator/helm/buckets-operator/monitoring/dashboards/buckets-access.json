{
 "uid": "buckets-access",
 "title": "Buckets / Access and services",
 "description": "Sign-ins, rejected requests and the KMS.",
 "tags": [
  "buckets"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0,
    "current": {}
   },
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "hide": 0,
    "query": {
     "query": "label_values(minio_cluster_drive_total{scope=\"cluster\"}, namespace)",
     "refId": "ns"
    },
    "definition": "label_values(minio_cluster_drive_total{scope=\"cluster\"}, namespace)",
    "current": {}
   },
   {
    "name": "cluster",
    "label": "Cluster",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "hide": 0,
    "query": {
     "query": "label_values(minio_cluster_drive_total{scope=\"cluster\", namespace=\"$namespace\"}, buckets_cluster)",
     "refId": "cl"
    },
    "definition": "label_values(minio_cluster_drive_total{scope=\"cluster\", namespace=\"$namespace\"}, buckets_cluster)",
    "current": {}
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [],
 "panels": [
  {
   "type": "row",
   "title": "Sign-ins",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Rejected S3 requests (bad credentials)",
   "description": "",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(minio_s3_requests_rejected_auth_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"node\"}[5m]))",
     "legendFormat": "bad credentials",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(minio_s3_requests_rejected_timestamp_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"node\"}[5m]))",
     "legendFormat": "clock skew",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "sum(rate(minio_s3_requests_rejected_invalid_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"node\"}[5m]))",
     "legendFormat": "invalid",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Failed console sign-ins",
   "description": "",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (method) (rate(buckets_console_logins_failed_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\"}[5m]))",
     "legendFormat": "{{method}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Client errors by API",
   "description": "",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (api) (rate(minio_s3_requests_4xx_errors_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"node\"}[5m]))",
     "legendFormat": "{{api}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "KMS",
   "id": 5,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "KMS requests",
   "description": "Only clusters with a KMS have these.",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(minio_cluster_kms_request_success{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"cluster\"}[5m]))",
     "legendFormat": "succeeded",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(minio_cluster_kms_request_error{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"cluster\"}[5m]))",
     "legendFormat": "refused",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "sum(rate(minio_cluster_kms_request_failure{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"cluster\"}[5m]))",
     "legendFormat": "failed (unreachable)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ]
}
