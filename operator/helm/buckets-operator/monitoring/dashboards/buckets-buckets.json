{
 "uid": "buckets-buckets",
 "title": "Buckets / Buckets",
 "description": "Usage, object counts, quotas and replication per bucket.",
 "tags": [
  "buckets"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0,
    "current": {}
   },
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "hide": 0,
    "query": {
     "query": "label_values(minio_cluster_drive_total{scope=\"cluster\"}, namespace)",
     "refId": "ns"
    },
    "definition": "label_values(minio_cluster_drive_total{scope=\"cluster\"}, namespace)",
    "current": {}
   },
   {
    "name": "cluster",
    "label": "Cluster",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "hide": 0,
    "query": {
     "query": "label_values(minio_cluster_drive_total{scope=\"cluster\", namespace=\"$namespace\"}, buckets_cluster)",
     "refId": "cl"
    },
    "definition": "label_values(minio_cluster_drive_total{scope=\"cluster\", namespace=\"$namespace\"}, buckets_cluster)",
    "current": {}
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "links": [],
 "panels": [
  {
   "type": "row",
   "title": "Usage",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "table",
   "title": "Buckets",
   "description": "",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (bucket) (minio_bucket_usage_total_bytes{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"bucket\"})",
     "legendFormat": "size",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "expr": "max by (bucket) (minio_bucket_usage_object_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"bucket\"})",
     "legendFormat": "objects",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "max by (bucket) (minio_bucket_usage_version_total{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"bucket\"})",
     "legendFormat": "versions",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "max by (bucket) (minio_bucket_quota_total_bytes{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"bucket\"})",
     "legendFormat": "quota",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "size",
       "Value #B": "objects",
       "Value #C": "versions",
       "Value #D": "quota"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "size"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "objects"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "versions"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "quota"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "type": "timeseries",
   "title": "Size",
   "description": "",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (bucket) (minio_bucket_usage_total_bytes{namespace=\"$namespace\", buckets_cluster=\"$cluster\", scope=\"bucket\"})",
     "legendFormat": "{{bucket}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
