# syntax=docker/dockerfile:1
# Build:  docker build -f docker/Dockerfile.bucketsd -t buckets/bucketsd .
# Run:    docker run -p 9000:9000 -v /srv/data:/data buckets/bucketsd

FROM debian:bookworm-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential cmake ninja-build git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DBUCKETS_BUILD_TESTS=OFF -DBUCKETS_BUILD_FUZZ=OFF \
 && ninja -C /build bucketsd \
 && strip /build/src/bucketsd

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /build/src/bucketsd /usr/local/bin/bucketsd
EXPOSE 9000
VOLUME ["/data"]
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/bucketsd"]
CMD ["server", "--address", ":9000", "/data"]
