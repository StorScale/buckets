# syntax=docker/dockerfile:1
# buckets-kes: Buckets' key server, speaking MinIO KES's API and reading its
# configuration. buckets-operator runs it for spec.kms.kes.
# Build:  docker build -f docker/Dockerfile.kes -t buckets/buckets-kes .

FROM debian:trixie-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential cmake ninja-build git ca-certificates libssl-dev perl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DBUCKETS_BUILD_TESTS=OFF -DBUCKETS_BUILD_FUZZ=OFF \
 && ninja -C /build buckets-kes \
 && strip /build/src/buckets-kes

# OpenSSL's FIPS provider, for the -fips image (docs/fips.md): scripts/build-fips-provider.sh sets the version.
FROM debian:trixie-slim AS fips-provider
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential perl curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY scripts/build-fips-provider.sh /usr/local/bin/build-fips-provider.sh
RUN build-fips-provider.sh /opt/fips

# The -fips image (docker build --target fips): FIPS mode always on, with the provider and the openssl
# program that installs it on each start (its security policy forbids copying that configuration).
FROM gcr.io/distroless/cc-debian13:nonroot AS fips
COPY --from=build /build/src/buckets-kes /usr/local/bin/buckets-kes
COPY --from=fips-provider /opt/fips/lib/ossl-modules/fips.so /usr/lib/buckets/fips/fips.so
COPY --from=fips-provider /opt/fips/bin/openssl /usr/lib/buckets/fips/openssl
ENV BUCKETS_FIPS=on
USER nonroot:nonroot
EXPOSE 7373
ENTRYPOINT ["/usr/local/bin/buckets-kes"]
CMD ["server", "--config", "/etc/kes/config/config.yaml"]

# The standard image (the default target).
FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=build /build/src/buckets-kes /usr/local/bin/buckets-kes
USER nonroot:nonroot
EXPOSE 7373
ENTRYPOINT ["/usr/local/bin/buckets-kes"]
CMD ["server", "--config", "/etc/kes/config/config.yaml"]
