# syntax=docker/dockerfile:1
# The web console: consoled (C) serving the SPA (React), deployed by the
# operator as its own Deployment (spec.console).
# Build:  docker build -f docker/Dockerfile.console -t buckets/buckets-console .

FROM node:24-bookworm-slim AS web
WORKDIR /web
COPY console/web/package.json console/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY console/web/ ./
RUN npm run build

FROM debian:bookworm-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential cmake ninja-build git ca-certificates libssl-dev perl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
      -DBUCKETS_BUILD_TESTS=OFF -DBUCKETS_BUILD_FUZZ=OFF \
 && ninja -C /build consoled \
 && strip /build/src/consoled

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /build/src/consoled /usr/local/bin/consoled
COPY --from=web /web/dist /usr/share/buckets-console
USER nonroot:nonroot
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/consoled"]
CMD ["--address", ":9090", "--web-dir", "/usr/share/buckets-console"]
