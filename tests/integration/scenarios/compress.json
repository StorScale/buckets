 },
 {
  "method": "DELETE",
  "path": "/cbkt/kms.txt",
  "label": "delete sse-kms (its ETag is random)"
 },
 {
  "method": "POST",
  "path": "/cbkt/encmp.txt",
  "label": "create sse upload",
  "query": "uploads",
  "headers": {
   "X-Amz-Server-Side-Encryption": "AES256"
  },
  "save": {
   "eu": "xml:UploadId"
  }
 },
 {
  "method": "PUT",
  "path": "/cbkt/encmp.txt",
  "label": "sse part 1",
  "query": "partNumber=1&uploadId=$eu",
  "body": "the quick brown fox jumps over the lazy dog 0123456789\n",
  "repeat": 100000,
  "show": [
   "etag"
  ],
  "save": {
   "f1": "etag"
  }
 },
 {
  "method": "PUT",
  "path": "/cbkt/encmp.txt",
  "label": "sse part 2",
  "query": "partNumber=2&uploadId=$eu",
  "body": "the quick brown fox jumps over the lazy dog 0123456789\n",
  "repeat": 10,
  "show": [
   "etag"
  ],
  "save": {
   "f2": "etag"
  }
 },
 {
  "method": "GET",
  "path": "/cbkt/encmp.txt",
  "label": "sse list parts",
  "query": "uploadId=$eu"
 },
 {
  "method": "POST",
  "path": "/cbkt/encmp.txt",
  "label": "sse complete",
  "query": "uploadId=$eu",
  "body": "<CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag>$f1</ETag></Part><Part><PartNumber>2</PartNumber><ETag>$f2</ETag></Part></CompleteMultipartUpload>"
 },
 {
  "method": "HEAD",
  "path": "/cbkt/encmp.txt",
  "label": "head sse mp",
  "show": [
