  },
  "show": [
   "content-range",
   "content-length"
  ]
 },
 {
  "method": "GET",
  "path": "/cbkt/encmp.txt",
  "label": "sse mp attributes",
  "query": "attributes",
  "headers": {
   "X-Amz-Object-Attributes": "ETag,ObjectSize,ObjectParts,StorageClass,Checksum"
  }
 },
 {
  "method": "GET",
  "path": "/cbkt",
  "label": "final list",
  "query": "list-type=2"
 },
 {
  "sleep": 8
 },
 {
  "method": "GET",
  "path": "/minio/admin/v3/datausageinfo",
