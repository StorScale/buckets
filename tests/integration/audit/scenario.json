  "label": "put tagging"
 },
 {
  "method": "DELETE",
  "path": "/abkt/p/a.txt",
  "query": "tagging",
  "label": "delete tagging"
 },
 {
  "method": "POST",
  "path": "/abkt/p/mp.bin",
  "query": "uploads",
  "save": {
   "u": "xml:UploadId"
  },
  "label": "mpu create"
 },
 {
  "method": "PUT",
  "path": "/abkt/p/mp.bin",
  "query": "partNumber=1&uploadId=$u",
  "body": "part-one",
  "save": {
   "e": "etag"
  },
  "label": "mpu part"
 },
 {
  "method": "POST",
  "path": "/abkt/p/mp.bin",
  "query": "uploadId=$u",
  "body": "<CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag>$e</ETag></Part></CompleteMultipartUpload>",
  "label": "mpu complete"
 },
 {
  "method": "DELETE",
  "path": "/abkt/p/b%20c+%C3%A9.txt",
  "label": "delete copy"
 },
 {
  "method": "DELETE",
  "path": "/abkt/p/none.txt",
  "label": "delete missing"
 },
 {
  "method": "POST",
  "path": "/abkt",
  "query": "delete",
  "md5": true,
  "body": "<Delete><Object><Key>p/a.txt</Key></Object><Object><Key>p/mp.bin</Key></Object></Delete>",
  "label": "delete objects"
 },
 {
  "method": "PUT",
  "path": "/abkt",
  "query": "versioning",
  "body": "<VersioningConfiguration><Status>Enabled</Status></VersioningConfiguration>",
